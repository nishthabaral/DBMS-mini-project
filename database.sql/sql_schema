# Complex queries
# 1. View All Orders with Customer Name
SELECT o.order_id, c.name AS customer_name, o.order_date
FROM Orders o
JOIN Customer c ON o.customer_id = c.customer_id;

# 2. View Order Details (Medicines per Order)
SELECT o.order_id, m.name AS medicine_name, oi.quantity
FROM Order_Items oi
JOIN Orders o ON oi.order_id = o.order_id
JOIN Medicine m ON oi.medicine_id = m.medicine_id;

# 3. Total Bill per Order
SELECT o.order_id, SUM(m.price * oi.quantity) AS total_amount
FROM Order_Items oi
JOIN Orders o ON oi.order_id = o.order_id
JOIN Medicine m ON oi.medicine_id = m.medicine_id
GROUP BY o.order_id;

# Low Stock Medicines
SELECT name, stock_quantity
FROM Medicine
WHERE stock_quantity < 60;

# Top Selling Medicines
SELECT m.name, SUM(oi.quantity) AS total_sold
FROM Order_Items oi
JOIN Medicine m ON oi.medicine_id = m.medicine_id
GROUP BY m.name
ORDER BY total_sold DESC;

# Supplier-wise Medicine Count
SELECT s.name AS supplier_name, COUNT(m.medicine_id) AS total_medicines
FROM Supplier s
JOIN Medicine m ON s.supplier_id = m.supplier_id
GROUP BY s.name;

